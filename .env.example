# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------

CATIA_AGENT_APP_NAME=CATIA Agent API
CATIA_AGENT_APP_VERSION=1.0.0
CATIA_AGENT_ENVIRONMENT=development

# ---------------------------------------------------------------------
# FastAPI
# ---------------------------------------------------------------------

CATIA_AGENT_API_HOST=127.0.0.1
CATIA_AGENT_API_PORT=8000
CATIA_AGENT_API_PREFIX=/api/v1
CATIA_AGENT_ENABLE_API_DOCS=true
# Planning-only budget; must exceed classifier + MCP + 2x model timeout.
# CATIA execution time is governed by PENDING_RUN_TIMEOUT_SECONDS.
CATIA_AGENT_REQUEST_TIMEOUT_SECONDS=120
CATIA_AGENT_REQUEST_BODY_MAX_BYTES=1048576

# ---------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------

CATIA_AGENT_MAX_USER_MESSAGE_CHARACTERS=10000
CATIA_AGENT_MAX_SESSION_ID_CHARACTERS=128
CATIA_AGENT_MAX_REQUEST_ID_CHARACTERS=128

# ---------------------------------------------------------------------
# Tool-calling model
# ---------------------------------------------------------------------

CATIA_AGENT_MODEL_TEMPERATURE=0

# ---------------------------------------------------------------------
# Azure AI Foundry (Qwen 3.6 27B)
#
# azure_foundry_endpoint is the base model deployment URL, without the
# trailing /chat/completions segment, for example
# https://<resource>.services.ai.azure.com/models
# ---------------------------------------------------------------------

CATIA_AGENT_AZURE_FOUNDRY_ENDPOINT=
CATIA_AGENT_AZURE_FOUNDRY_API_KEY=
CATIA_AGENT_AZURE_FOUNDRY_DEPLOYMENT_NAME=qwen3.6-27b
CATIA_AGENT_AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
CATIA_AGENT_AZURE_FOUNDRY_REQUEST_TIMEOUT_SECONDS=45
CATIA_AGENT_AZURE_FOUNDRY_MAX_TOKENS=2048
CATIA_AGENT_AZURE_FOUNDRY_ENABLE_THINKING=true

# ---------------------------------------------------------------------
# MCP
# ---------------------------------------------------------------------

CATIA_AGENT_MCP_SERVER_URL=http://127.0.0.1:8001/mcp
CATIA_AGENT_MCP_REQUEST_TIMEOUT_SECONDS=15
CATIA_AGENT_MCP_TOOL_CACHE_TTL_SECONDS=60

# MCP guardrails. The API key is a shared secret: the MCP server
# requires it as a bearer token and the agent sends it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty disables MCP authentication (local development only).
CATIA_AGENT_MCP_API_KEY=
# enforce | warn | off. After intentionally changing a tool in
# catia_mcp/server.py, re-pin: python -m catia_agent.mcp_guardrails pin
CATIA_AGENT_MCP_TOOL_PINNING_MODE=enforce
CATIA_AGENT_MCP_MAX_TOOL_COUNT=50
CATIA_AGENT_MCP_MAX_TOOL_DESCRIPTION_CHARACTERS=6000
CATIA_AGENT_MCP_MAX_TOOL_SCHEMA_BYTES=16384
CATIA_AGENT_MCP_MAX_TOOL_PROPERTIES=30

# When false, GET /ready reuses the existing MCP tool cache instead of
# forcing a full MCP re-discovery round trip on every readiness check.
CATIA_AGENT_READINESS_FORCE_MCP_REFRESH=false

# ---------------------------------------------------------------------
# Embedding-based ask-vs-agent intent classification
#
# Decides whether a message is a CATIA action request or a general/
# informational message using a local Ollama embedding model, instead
# of spending a chat-model round trip on that decision. Ollama is used
# only for these embeddings. On failure or timeout the classifier is
# skipped for the cooldown period and the model decides instead.
# ---------------------------------------------------------------------

CATIA_AGENT_ENABLE_EMBEDDING_INTENT_CLASSIFIER=true
CATIA_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
CATIA_AGENT_INTENT_CLASSIFIER_MODEL=qllama/bge-small-en-v1.5
CATIA_AGENT_INTENT_CLASSIFIER_TIMEOUT_SECONDS=5
CATIA_AGENT_INTENT_CLASSIFIER_FAILURE_COOLDOWN_SECONDS=30
CATIA_AGENT_INTENT_CLASSIFIER_TOP_K=3
CATIA_AGENT_INTENT_CLASSIFIER_AGENTIC_THRESHOLD=0.48
CATIA_AGENT_INTENT_CLASSIFIER_AGENTIC_MARGIN=0.03

# ---------------------------------------------------------------------
# Agent workflow
# ---------------------------------------------------------------------

CATIA_AGENT_MAX_CONVERSATION_HISTORY_MESSAGES=20
CATIA_AGENT_ENABLE_CONVERSATION_HISTORY=false
CATIA_AGENT_MAX_ACTIONS_PER_RUN=20
CATIA_AGENT_ENABLE_MULTI_ACTION_SEQUENCES=false
CATIA_AGENT_MAX_COMPLETED_ACTION_RESULT_BYTES=262144
# Max time a run waits for .NET to report a CATIA action result. Must
# exceed the slowest CATIA operation (some take 5+ minutes).
CATIA_AGENT_PENDING_RUN_TIMEOUT_SECONDS=3600

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------

CATIA_AGENT_LOG_LEVEL=INFO
CATIA_AGENT_ENABLE_JSON_LOGS=true
CATIA_AGENT_INCLUDE_TECHNICAL_DETAILS_IN_ERRORS=false

# Daily log files: <dir>\CatiaAgentApi_YYYYMMDD.log and
# CatiaAgentMcp_YYYYMMDD.log. The directory is created if missing.
CATIA_AGENT_ENABLE_FILE_LOGGING=true
CATIA_AGENT_LOG_DIRECTORY=C:\Temp\AI_Logs
CATIA_AGENT_LOG_FILE_RETENTION_DAYS=30
CATIA_AGENT_SLOW_REQUEST_THRESHOLD_MS=30000

# ---------------------------------------------------------------------
# Operational endpoints
# ---------------------------------------------------------------------

CATIA_AGENT_ENABLE_TOOL_CATALOG_ENDPOINT=true
CATIA_AGENT_ENABLE_TOOL_CACHE_CLEAR_ENDPOINT=true

# Keep empty for the current local development workflow.
CATIA_AGENT_ADMIN_API_KEY=